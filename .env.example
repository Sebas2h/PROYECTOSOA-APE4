# Copiar como .env.local o cargar mediante scripts; nunca versionar valores reales.
DB_HOST=127.0.0.1
DB_PORT=3306
VEHICULOS_DB=venta_vehiculos
VENTAS_DB=ventas_service
NOTIFICACIONES_DB=notificaciones_service
DB_USER=root
DB_PASSWORD=

JWT_SECRET=REEMPLAZAR_BASE64_MINIMO_32_BYTES
OAUTH_CLIENT_ID=vehiculos-client
OAUTH_CLIENT_SECRET=REEMPLAZAR_CLIENT_SECRET
VENTAS_SERVICE_KEY=REEMPLAZAR_CLAVE_SERVICIO_MINIMO_32
NOTIFICACIONES_KEY=REEMPLAZAR_CLAVE_NOTIFICACIONES_MINIMO_32

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=ventas.events
RABBITMQ_QUEUE=notificaciones.ventas
RABBITMQ_ROUTING_KEY=venta.completada

JAVA_URL=http://127.0.0.1:8090
NOTIFICACIONES_URL=http://127.0.0.1:8090
NOTIFICATION_TRANSPORT=rabbitmq
NOTIFICACIONES_PORT=8181

